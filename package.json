{
  "name": "dsh-agensi-mcp",
  "version": "0.2.1",
  "description": "Agensi (skill marketplace) as native mcp__agensi__* tools in DeepSeek Harness: a direct Streamable HTTP MCP connection with a sign-in card in the plugin page — OAuth 2.1, live status and expiry, no pasted tokens.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "agensi",
    "agent-skills",
    "oauth",
    "i18n"
  ],
  "license": "MIT",
  "author": "yangjiacheng",
  "homepage": "https://github.com/oooplz/dsh-agensi-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oooplz/dsh-agensi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/oooplz/dsh-agensi-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
